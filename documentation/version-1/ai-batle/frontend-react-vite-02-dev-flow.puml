@startuml
title Frontend - Flujo de desarrollo

skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontColor #334155
skinparam ArrowColor #16a34a
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #1e3a5f
  FontColor #334155
  StartColor #16a34a
  EndColor #16a34a
}

start
:Codigo React\ncomponentes + paginas;
:Vite Dev Server\nrecarga rapida en desarrollo;
:Browser\nvisualiza la app;
:FastAPI\nconsume endpoints REST;
:PostgreSQL\nlee noticias, metricas\ny preferencias;
stop

note right
Para una slide simple:
"Frontend React"

Para una slide tecnica:
"React + Vite"
end note

@enduml
