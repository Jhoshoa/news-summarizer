@startuml
title EcoBrief Bolivia - Pipeline de procesamiento

skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontColor #334155
skinparam ArrowColor #16a34a
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #1e3a5f
  FontColor #334155
  StartColor #16a34a
  EndColor #16a34a
}

start

:Recolectar\nnoticias;
:Filtrar\ncontenido util;
:Deduplicar\nrepetidos;
:Clasificar\npor categoria;
:Rankear\npor relevancia;
:Seleccionar\ncandidatos;
:Resumir\ncon IA;
note right
La IA se usa al final,
solo con candidatos relevantes.
end note
:Publicar\nbriefs y metricas;

stop

@enduml
