@startuml
title Fase 2 - Filtrado y deduplicacion

skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontColor #334155
skinparam ArrowColor #16a34a
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #1e3a5f
  FontColor #334155
  StartColor #16a34a
  EndColor #16a34a
}

start

:Noticias recolectadas;
:Filtro de calidad;

note right
Descarta articulos:
- sin contenido suficiente
- sin fecha valida
- con texto pobre o repetido
end note

:Normalizar URL\ny titulo;
:Deduplicacion en lote;

note right
Dentro de la corrida:
- URL hash
- titulo normalizado
- similitud de titulos
end note

:Conservar articulos\nutiles y unicos;

stop

@enduml
