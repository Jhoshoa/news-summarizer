@startuml
title Fase 4 - Generacion y distribucion

skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontColor #334155
skinparam ArrowColor #16a34a
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #1e3a5f
  FontColor #334155
  StartColor #16a34a
  EndColor #16a34a
}

start

:Seleccionar mejores\ncandidatos unicos;
:Enviar candidatos\nal modelo de IA;
:Generar resumen breve\ncon LLM;
:Normalizar estilo\ndel resumen;
:Guardar resultados\ny metricas de impacto;
:Preparar entrega\nsegun preferencias;

if (Canal del suscriptor?) then (email)
  :Enviar por Email;
elseif (Canal Telegram?) then (telegram)
  :Enviar por Telegram;
else (whatsapp)
  :Enviar por WhatsApp;
endif

note right
La IA se usa al final,
solo con candidatos
filtrados y priorizados.
end note

stop

@enduml
