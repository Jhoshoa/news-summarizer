# Use these variables in Dokploy/Hostinger production.
# Do not commit the real .env with secrets.

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Opcional pero recomendado en produccion: error tracking. sentry-sdk[fastapi]
# ya esta instalado; sin SENTRY_DSN simplemente no hace nada. Crear un
# proyecto gratuito en sentry.io y pegar el DSN aca para enterarse de bugs de
# produccion (como el de Telegram) sin depender de que alguien reporte.
SENTRY_DSN=

# Public URLs that are allowed to call the API.
CORS_ORIGINS=https://ecobriefbolivia.online,https://briefs.ecobriefbolivia.online

# Frontend build-time API URL.
# If Dokploy/proxy routes /api and /trigger on the same domain as the frontend, this may be empty.
# If the API has its own public domain, use that full URL.
VITE_API_BASE_URL=https://ecobriefbolivia.online
VITE_ENABLE_MANUAL_REFRESH=false

POSTGRES_USER=news_user
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=news_summarizer
POSTGRES_HOST_PORT=5433

# LLM_FALLBACK_ORDER queda sin setear a proposito: sin esta variable,
# settings.py cae al orden definido en el codigo (src/config/settings.py),
# que ya incluye gemini -- misma logica que DEFAULT_CATEGORIES, ver
# docs/mejorar-comportamiento-categorias/plan-categorias.md.
#LLM_FALLBACK_ORDER=
GROQ_API_KEY=
OPENAI_API_KEY=
GITHUB_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
LLM_BASE_URL=

NEWS_API_KEY=
NEWS_API_COUNTRY=bo
NEWS_API_LANGUAGE=es

SCRAPER_ENABLED=true
SCRAPER_CONCURRENCY=3
SCRAPER_TIMEOUT=30
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
SCRAPER_SOURCES=radiofides,unitel,reduno,redbolivision,lostiempos,eldeber

API_AUTH_KEY=replace-with-a-long-random-secret

EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=EcoBrief Bolivia
EMAIL_REQUIRE_VERIFICATION=false

# TELEGRAM_WEBHOOK_URL debe ser el dominio publico HTTPS del backend (ej.
# https://api.tudominio.com), sin la ruta /webhook/telegram al final — la app
# la agrega sola al registrar el webhook con Telegram en el arranque.
# TELEGRAM_WEBHOOK_SECRET es opcional pero recomendado: si se define, Telegram
# lo reenvia en cada request y el endpoint lo valida antes de procesar el
# update, evitando que cualquiera pueda mandar updates falsos a la URL.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# TWILIO_WEBHOOK_URL debe ser exactamente la URL configurada en la consola de
# Twilio (https://<dominio>/webhook/whatsapp) — se usa junto con
# TWILIO_AUTH_TOKEN para validar la firma X-Twilio-Signature de cada request
# entrante. Sin esto, cualquiera que encuentre la URL podria mandar mensajes
# falsos (ej. dar de baja a cualquier numero).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_URL=

SCHEDULE_TIMEZONE=America/La_Paz
SCHEDULE_SUMMARY_MORNING=10:00
SCHEDULE_SUMMARY_AFTERNOON=16:00
SCHEDULE_SUMMARY_NIGHT=20:00

CRON_RUN_ONCE=false
CRON_ECONOMIC_REFRESH_EVERY=1
CRON_ECONOMIC_REFRESH_UNIT=hours
CRON_SUMMARY_REFRESH_HOURS=8,10,13,16,19,22
CRON_SUMMARY_REFRESH_EVERY=4
CRON_SUMMARY_REFRESH_UNIT=hours
CRON_ECONOMIC_REQUEST_TIMEOUT_SECONDS=60
CRON_SUMMARY_REQUEST_TIMEOUT_SECONDS=600
CRON_DELIVERY_REQUEST_TIMEOUT_SECONDS=180
CRON_REQUEST_TIMEOUT_SECONDS=180
CRON_REQUEST_RETRIES=2
CRON_SUMMARY_TRIGGER_PATH=/trigger/summary
CRON_SUMMARY_TIME_OF_DAY=manual
CRON_DELIVERY_TRIGGER_PATH=/trigger/delivery

# No seteada a proposito: sin esta variable, settings.py deriva la lista directo de
# DEFAULT_CATEGORIES en src/db/repository.py (la unica fuente de verdad). Si el
# servidor de produccion tiene esta variable seteada explicitamente, hay que
# borrarla ahi tambien (no solo actualizarla) para que deje de desincronizarse.
#DEFAULT_CATEGORIES=
SUMMARY_CANDIDATES_PER_CATEGORY=5
SUMMARY_CANDIDATES_EXTENDED_CATEGORIES=politica, economia
SUMMARY_CANDIDATES_EXTENDED_LIMIT=8
