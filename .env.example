# ===========================================
# CONFIGURACIÓN GENERAL
# ===========================================
# ENVIRONMENT=development   # local
# ENVIRONMENT=production    # docker / DockPloy
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# Orígenes permitidos para CORS (separados por coma)
# Local: http://localhost:5173 (Vite dev)
# DockPloy: https://tudominio.com,https://www.tudominio.com
CORS_ORIGINS=http://localhost:5173

# ===========================================
# LLM - IA (con failover automatico)
# ===========================================
# Orden de failover cuando un provider alcanza rate limit
LLM_FALLBACK_ORDER=groq,github,nvidia,openai
GROQ_API_KEY=
OPENAI_API_KEY=
GITHUB_API_KEY=
NVIDIA_API_KEY=

# ===========================================
# NEWS API - Fuentes de Noticias (Backup)
# ===========================================
NEWS_API_KEY=
NEWS_API_COUNTRY=bo
NEWS_API_LANGUAGE=es

# ===========================================
# SCRAPING - Web Scraping Boliviano
# ===========================================
SCRAPER_ENABLED=true
SCRAPER_CONCURRENCY=3
SCRAPER_TIMEOUT=30
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Fuentes habilitadas
SCRAPER_SOURCES=radiofides,unitel,reduno,redbolivision

# ===========================================
# WHATSAPP - Twilio
# ===========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_URL=

# ===========================================
# TELEGRAM
# ===========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# ===========================================
# EMAIL - SMTP/Gmail para MVP
# ===========================================
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=EcoBrief Bolivia
EMAIL_REQUIRE_VERIFICATION=false

# ===========================================
# BASE DE DATOS
# ===========================================
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://news_user:news_password@localhost:5433/news_summarizer
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
NEWS_CACHE_TTL_MINUTES=60
NEWS_MIN_ARTICLES=20
NEWS_SUMMARY_RETENTION_DAYS=30

# ===========================================
# SCHEDULER
# ===========================================
SCHEDULE_TIMEZONE=America/La_Paz
# Ventanas de envio segun preferred_time:
# manana -> morning -> 09:00
# tarde  -> afternoon -> 16:00
# noche  -> night -> 20:00
# Para probar, cambia temporalmente una hora al minuto siguiente y reinicia el backend.
SCHEDULE_SUMMARY_MORNING=09:00
SCHEDULE_SUMMARY_AFTERNOON=16:00
SCHEDULE_SUMMARY_NIGHT=20:00
# Legacy opcional: si lo defines, envia a usuarios de tarde o noche como alias evening.
SCHEDULE_SUMMARY_EVENING=
API_AUTH_KEY=change-me-local-api-auth-key
VITE_ENABLE_MANUAL_REFRESH=false

# ===========================================
# CRON JOB CONTAINER
# ===========================================
# En Docker: http://backend:8000
# En local:  http://host.docker.internal:8000
CRON_BACKEND_BASE_URL=http://host.docker.internal:8000
# false = el container queda corriendo por intervalos. true = corre una vez y termina.
CRON_RUN_ONCE=false
# Ejemplo: indicadores cada 10 minutos. Para cada hora usa 1/hours.
# CRON_ECONOMIC_REFRESH_EVERY=10
# CRON_ECONOMIC_REFRESH_UNIT=minutes
CRON_ECONOMIC_REFRESH_EVERY=1
CRON_ECONOMIC_REFRESH_UNIT=hours
# Horarios fijos (8am, 10am, 1pm, 4pm, 7pm, 10pm). Opcional: si se omite usa CRON_SUMMARY_REFRESH_EVERY.
# CRON_SUMMARY_REFRESH_HOURS=8,10,13,16,19,22
# O por intervalo (legacy):
# CRON_SUMMARY_REFRESH_EVERY=3
# CRON_SUMMARY_REFRESH_UNIT=hours
CRON_ECONOMIC_REQUEST_TIMEOUT_SECONDS=60
CRON_SUMMARY_REQUEST_TIMEOUT_SECONDS=300
# Fallback global legacy para ambos si no defines los anteriores.
# CRON_REQUEST_TIMEOUT_SECONDS=180
CRON_REQUEST_RETRIES=2
# Endpoint usado por cron-job para refrescar/generar summaries.
# Este flujo puede hacer scraping, deduplicar, rankear, llamar LLM y guardar summaries.
CRON_SUMMARY_TRIGGER_PATH=/trigger/summary
# Etiqueta enviada al refresh. En este flujo no se entrega por ventana.
CRON_SUMMARY_TIME_OF_DAY=manual

# Entrega de briefs cacheados a suscriptores.
# Este flujo NO hace scraping ni llama LLM; solo envia summaries ya guardados.
CRON_DELIVERY_TRIGGER_PATH=/trigger/delivery
CRON_DELIVERY_REQUEST_TIMEOUT_SECONDS=180
# Las horas de entrega del cron-job usan SCHEDULE_SUMMARY_MORNING/AFTERNOON/NIGHT.
# Para probar, cambia temporalmente una de esas horas al minuto siguiente y reinicia el cron-job.

# ===========================================
# RESUMEN - Candidatos por categoría
# ===========================================
# Límite base de candidatos a resumir por categoría
SUMMARY_CANDIDATES_PER_CATEGORY=5
# Categorías que reciben un límite mayor (separadas por coma)
SUMMARY_CANDIDATES_EXTENDED_CATEGORIES=politica, economia
# Límite extendido para esas categorías
SUMMARY_CANDIDATES_EXTENDED_LIMIT=8

# ===========================================
# CATEGORÍAS POR DEFECTO
# ===========================================
DEFAULT_CATEGORIES=economia,politica,deportes,tecnologia,entretenimiento
