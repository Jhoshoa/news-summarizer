# ===========================================
# CONFIGURACIÓN GENERAL
# ===========================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# ===========================================
# LLM - IA (Groq Free / OpenAI Paid)
# ===========================================
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=

# Modelos
LLM_MODEL_SUMMARIZE=llama-3.3-70b-versatile
LLM_MODEL_CLASSIFY=llama-3.1-8b-instant
LLM_MODEL_REWRITE=llama-3.1-70b-versatile

# ===========================================
# NEWS API - Fuentes de Noticias (Backup)
# ===========================================
NEWS_API_KEY=
NEWS_API_COUNTRY=bo
NEWS_API_LANGUAGE=es

# ===========================================
# SCRAPING - Web Scraping Boliviano
# ===========================================
SCRAPER_ENABLED=true
SCRAPER_CONCURRENCY=3
SCRAPER_TIMEOUT=30
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Fuentes habilitadas
SCRAPER_SOURCES=radiofides,unitel,reduno,redbolivision

# ===========================================
# WHATSAPP - Twilio
# ===========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_URL=

# ===========================================
# TELEGRAM
# ===========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# ===========================================
# EMAIL - Mailchimp
# ===========================================
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=us1
MAILCHIMP_LIST_ID=

# ===========================================
# BASE DE DATOS
# ===========================================
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://news_user:news_password@localhost:5433/news_summarizer
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
NEWS_CACHE_TTL_MINUTES=60
NEWS_MIN_ARTICLES=20
NEWS_SUMMARY_RETENTION_DAYS=30

# ===========================================
# SCHEDULER
# ===========================================
SCHEDULE_TIMEZONE=America/La_Paz
SCHEDULE_SUMMARY_MORNING=08:00
SCHEDULE_SUMMARY_EVENING=18:00
API_AUTH_KEY=change-me-local-api-auth-key
VITE_ENABLE_MANUAL_REFRESH=false

# ===========================================
# CRON JOB CONTAINER
# ===========================================
CRON_BACKEND_BASE_URL=http://host.docker.internal:8000
# false = el container queda corriendo por intervalos. true = corre una vez y termina.
CRON_RUN_ONCE=false
# Ejemplo: indicadores cada 10 minutos. Para cada hora usa 1/hours.
# CRON_ECONOMIC_REFRESH_EVERY=10
# CRON_ECONOMIC_REFRESH_UNIT=minutes
CRON_ECONOMIC_REFRESH_EVERY=1
CRON_ECONOMIC_REFRESH_UNIT=hours
# Ejemplo: summaries cada 10 minutos. Para ahorrar LLM en demo, 3/hours es mas seguro.
# CRON_SUMMARY_REFRESH_EVERY=10
# CRON_SUMMARY_REFRESH_UNIT=minutes
CRON_SUMMARY_REFRESH_EVERY=3
CRON_SUMMARY_REFRESH_UNIT=hours
CRON_ECONOMIC_REQUEST_TIMEOUT_SECONDS=60
CRON_SUMMARY_REQUEST_TIMEOUT_SECONDS=300
# Fallback global legacy para ambos si no defines los anteriores.
# CRON_REQUEST_TIMEOUT_SECONDS=180
CRON_REQUEST_RETRIES=2
# Etiqueta enviada a /trigger/summary como time_of_day. Para cron/demo usa manual.
CRON_SUMMARY_TIME_OF_DAY=manual

# ===========================================
# CATEGORÍAS POR DEFECTO
# ===========================================
DEFAULT_CATEGORIES=economia,politica,deportes,tecnologia,entretenimiento
