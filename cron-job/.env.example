BACKEND_BASE_URL=http://host.docker.internal:8000
API_AUTH_KEY=change-me-local-api-auth-key
# false = el container queda corriendo por intervalos. true = corre una vez y termina.
RUN_ONCE=false
SCHEDULE_TIMEZONE=America/La_Paz

# Ejemplo: indicadores cada 10 minutos. Para cada hora usa 1/hours.
# ECONOMIC_REFRESH_EVERY=10
# ECONOMIC_REFRESH_UNIT=minutes
ECONOMIC_REFRESH_EVERY=1
ECONOMIC_REFRESH_UNIT=hours

# Resumen: horarios fijos (8am, 10am, 1pm, 4pm, 7pm, 10pm).
# Se ejecuta SOLO a esas horas (vacio = no corre, quitar = usa SUMMARY_REFRESH_EVERY).
SUMMARY_REFRESH_HOURS=8,10,13,16,19,22
ECONOMIC_REQUEST_TIMEOUT_SECONDS=60
SUMMARY_REQUEST_TIMEOUT_SECONDS=300

# Fallback global legacy para ambos si no defines los anteriores.
# REQUEST_TIMEOUT_SECONDS=180
REQUEST_RETRIES=2

# Refresh/generacion de contenido.
# Este flujo puede hacer scraping, deduplicar, rankear, llamar LLM y guardar summaries.
SUMMARY_TRIGGER_PATH=/trigger/summary
SUMMARY_TIME_OF_DAY=manual

# Delivery de briefs cacheados.
# Este flujo NO hace scraping ni llama LLM; solo envia summaries ya guardados.
DELIVERY_TRIGGER_PATH=/trigger/delivery
DELIVERY_REQUEST_TIMEOUT_SECONDS=180

# Ventanas de envio segun preferred_time:
# manana -> morning -> 09:00
# tarde  -> afternoon -> 16:00
# noche  -> night -> 20:00
#
# El cron-job tambien acepta DELIVERY_MORNING_AT, DELIVERY_AFTERNOON_AT y DELIVERY_NIGHT_AT.
# Dejamos SCHEDULE_SUMMARY_* como alias compatible con el backend para que sea mas facil de leer.
SCHEDULE_SUMMARY_MORNING=09:00
SCHEDULE_SUMMARY_AFTERNOON=16:00
SCHEDULE_SUMMARY_NIGHT=20:00

# Ejemplo de prueba local:
# Si son las 15:27 y quieres probar el envio de tarde en dos minutos:
# SCHEDULE_SUMMARY_AFTERNOON=15:29

LOG_LEVEL=INFO
