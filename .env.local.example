# Copy this file to .env when running the full stack locally with Docker Compose.

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# Local browser -> local Docker ports.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_MANUAL_REFRESH=false

# Local database exposed from the postgres container.
POSTGRES_USER=news_user
POSTGRES_PASSWORD=news_password
POSTGRES_DB=news_summarizer
POSTGRES_HOST_PORT=5433

# Required for summary generation. Set at least one key -- the router tries
# providers in order and skips any without a key. LLM_FALLBACK_ORDER is left
# unset on purpose: without it, settings.py falls back to the order defined
# in code (src/config/settings.py), so it never needs to be kept in sync by
# hand across .env files (same lesson as DEFAULT_CATEGORIES -- see
# docs/mejorar-comportamiento-categorias/plan-categorias.md).
#LLM_FALLBACK_ORDER=
GROQ_API_KEY=
OPENAI_API_KEY=
GITHUB_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
LLM_BASE_URL=
# Segundos maximos por llamada a un proveedor antes de pasar al siguiente.
LLM_TIMEOUT=45

SCRAPER_ENABLED=true
SCRAPER_CONCURRENCY=3
SCRAPER_TIMEOUT=30
SCRAPER_DETAIL_REFRESH_HOURS=3
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
SCRAPER_SOURCES=radiofides,unitel,reduno,redbolivision,lostiempos,eldeber

API_AUTH_KEY=change-me-local-api-auth-key

EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=EcoBrief Bolivia
EMAIL_REQUIRE_VERIFICATION=false

# En local normalmente se deja TELEGRAM_WEBHOOK_URL vacio (Telegram exige
# HTTPS publico) — el bot igual puede ENVIAR mensajes con solo el token; solo
# la recepcion de mensajes (webhook) necesita una URL publica real.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp via la API directa de Meta (WhatsApp Cloud API), sin Twilio.
# En local, WHATSAPP_META_VERIFY_TOKEN/APP_SECRET solo importan si vas a
# recibir mensajes (webhook, requiere URL publica real, igual que Telegram
# arriba) -- para solo ENVIAR alcanza con el access token y el phone_number_id.
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_API_VERSION=v21.0
WHATSAPP_META_VERIFY_TOKEN=
WHATSAPP_META_APP_SECRET=

SCHEDULE_TIMEZONE=America/La_Paz
SCHEDULE_SUMMARY_MORNING=10:00
SCHEDULE_SUMMARY_AFTERNOON=16:00
SCHEDULE_SUMMARY_NIGHT=20:00

CRON_RUN_ONCE=false
CRON_ECONOMIC_REFRESH_EVERY=1
CRON_ECONOMIC_REFRESH_UNIT=hours
CRON_SUMMARY_REFRESH_HOURS=8,10,13,16,19,22
CRON_SUMMARY_REFRESH_EVERY=4
CRON_SUMMARY_REFRESH_UNIT=hours
CRON_ECONOMIC_REQUEST_TIMEOUT_SECONDS=60
CRON_SUMMARY_REQUEST_TIMEOUT_SECONDS=600
CRON_DELIVERY_REQUEST_TIMEOUT_SECONDS=180
CRON_REQUEST_TIMEOUT_SECONDS=180
CRON_REQUEST_RETRIES=2
CRON_SUMMARY_TRIGGER_PATH=/trigger/summary
CRON_SUMMARY_TIME_OF_DAY=manual
CRON_DELIVERY_TRIGGER_PATH=/trigger/delivery

# No seteada a proposito: sin esta variable, settings.py deriva la lista directo de
# DEFAULT_CATEGORIES en src/db/repository.py (la unica fuente de verdad).
#DEFAULT_CATEGORIES=
SUMMARY_CANDIDATES_PER_CATEGORY=5
SUMMARY_CANDIDATES_EXTENDED_CATEGORIES=politica, economia
SUMMARY_CANDIDATES_EXTENDED_LIMIT=8
