# Use these variables for the AWS EC2 (free tier) deployment, on top of the
# same docker-compose.yml used everywhere else. See DEPLOYMENT.md ->
# "Production on AWS EC2 (Free Tier)" for the full runbook.
# Do not commit the real .env with secrets.

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

SENTRY_DSN=

# Public hostnames for this deployment. Used by Caddy (docker-compose.aws.yml)
# to request its Let's Encrypt certificate (all three on one cert) and by the
# app for CORS. Each must already resolve (A record) to the instance's Elastic
# IP before Caddy is started, or the certificate request will fail.
DOMAIN=ecobriefbolivia.online
WWW_DOMAIN=www.ecobriefbolivia.online
BRIEFS_DOMAIN=briefs.ecobriefbolivia.online
CORS_ORIGINS=https://ecobriefbolivia.online,https://www.ecobriefbolivia.online,https://briefs.ecobriefbolivia.online

# Para armar links "leer completo" en canales que no muestran el articulo
# entero (Telegram, email). El mismo dominio de arriba.
SITE_BASE_URL=https://ecobriefbolivia.online

# Empty: Caddy serves the frontend and proxies /api, /trigger, /webhook, /admin,
# /health, /stats to the backend on the SAME domain (see deploy/aws/Caddyfile),
# so the frontend can call relative paths without a separate API host.
VITE_API_BASE_URL=
VITE_ENABLE_MANUAL_REFRESH=false

# 1GiB instance: 2 gunicorn workers instead of the default 4. Bump this if you
# resize to a bigger instance later.
GUNICORN_WORKERS=2

POSTGRES_USER=news_user
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=news_summarizer
POSTGRES_HOST_PORT=5433

GROQ_API_KEY=
OPENAI_API_KEY=
GITHUB_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT=45
SUMMARY_CONCURRENCY=4

SCRAPER_ENABLED=true
SCRAPER_CONCURRENCY=3
SCRAPER_DETAIL_CONCURRENCY=5
SCRAPER_TIMEOUT=30
SCRAPER_DETAIL_REFRESH_HOURS=3
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

API_AUTH_KEY=replace-with-a-long-random-secret

# Ej. Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USERNAME y
# SMTP_PASSWORD son el login/SMTP key de Settings > SMTP & API > SMTP (no tu
# password de cuenta), SMTP_FROM_EMAIL debe ser un remitente verificado ahi.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=EcoBrief Bolivia
DELIVERY_CONCURRENCY=5

# Same rules as .env.prod.example: full public HTTPS origin, no path.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_API_VERSION=v21.0
WHATSAPP_META_VERIFY_TOKEN=
WHATSAPP_META_APP_SECRET=

SCHEDULE_TIMEZONE=America/La_Paz
SCHEDULE_SUMMARY_MORNING=10:00

CRON_RUN_ONCE=false
CRON_ECONOMIC_REFRESH_EVERY=1
CRON_ECONOMIC_REFRESH_UNIT=hours
CRON_SUMMARY_REFRESH_HOURS=8,10,13,16,19,22
CRON_SUMMARY_REFRESH_EVERY=4
CRON_SUMMARY_REFRESH_UNIT=hours
CRON_ECONOMIC_REQUEST_TIMEOUT_SECONDS=60
CRON_SUMMARY_REQUEST_TIMEOUT_SECONDS=600
CRON_DELIVERY_REQUEST_TIMEOUT_SECONDS=180
CRON_REQUEST_TIMEOUT_SECONDS=180
CRON_REQUEST_RETRIES=2
CRON_SUMMARY_TRIGGER_PATH=/trigger/summary
CRON_SUMMARY_TIME_OF_DAY=manual
CRON_DELIVERY_TRIGGER_PATH=/trigger/delivery

SUMMARY_CANDIDATES_PER_CATEGORY=5
SUMMARY_CANDIDATES_EXTENDED_CATEGORIES=politica, economia
SUMMARY_CANDIDATES_EXTENDED_LIMIT=8
