FROM node:20-alpine AS build
ARG VITE_API_BASE_URL=
ARG VITE_ENABLE_MANUAL_REFRESH=false
ARG VITE_ECONOMIC_INDICATORS_POLL_SECONDS=60
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_ENABLE_MANUAL_REFRESH=$VITE_ENABLE_MANUAL_REFRESH
ENV VITE_ECONOMIC_INDICATORS_POLL_SECONDS=$VITE_ECONOMIC_INDICATORS_POLL_SECONDS
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:20-alpine
RUN npm install -g serve
WORKDIR /app
COPY --from=build /app/dist ./dist
EXPOSE 5173
CMD ["serve", "-s", "dist", "-l", "5173"]
