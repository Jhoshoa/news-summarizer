# API base URL: empty = same origin (works when nginx proxies /api to backend)
# Set to full URL if backend is on a different domain:
# VITE_API_BASE_URL=https://api.tudominio.com
VITE_API_BASE_URL=

VITE_ENABLE_MANUAL_REFRESH=false

# Cada cuanto (en segundos) el navegador sondea el ultimo valor de los
# indicadores economicos para actualizar el grafico del dolar en vivo sin
# recargar la pagina. Se resuelve en build-time (queda horneado en el bundle
# de Vite), asi que un cambio requiere rebuildear el frontend, no solo
# reiniciar el contenedor.
VITE_ECONOMIC_INDICATORS_POLL_SECONDS=60
